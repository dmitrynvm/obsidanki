{
	"name": "obsidanki",
	"version": "2.0.0",
	"description": "Study flashcards from your Obsidian notes on an Anki-style review screen.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian-plugin",
		"flashcards",
		"spaced-repetition",
		"anki"
	],
	"author": "Dmitrii Nikolaev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dmitrynvm/obsidanki.git"
	},
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"esbuild": "0.25.0",
		"obsidian": "1.14.4",
		"tslib": "^2.6.3",
		"typescript": "4.7.4"
	},
	"dependencies": {
		"@codemirror/language": "^6.8.0",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.13",
		"@emotion/react": "^11.10.4",
		"@emotion/styled": "^11.10.4",
		"@mui/icons-material": "^5.10.3",
		"@mui/material": "^5.13.3",
		"@types/react-dom": "^18.0.6",
		"i18next": "^22.5.0",
		"json-rules-engine": "^7.3.1",
		"lowdb": "^6.0.1",
		"minimatch": "^10.0.3",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"react-i18next": "^12.3.1"
	},
	"resolutions": {
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.13"
	}
}
